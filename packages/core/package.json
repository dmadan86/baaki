{
  "name": "@baaki/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./money": "./src/money/index.ts",
    "./split": "./src/split/index.ts",
    "./balances": "./src/balances/index.ts",
    "./simplify": "./src/simplify/index.ts",
    "./settlement": "./src/settlement/index.ts",
    "./sync": "./src/sync/index.ts",
    "./notifications": "./src/notifications/index.ts",
    "./observability": "./src/observability/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "esbuild src/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=dist/core.js",
    "build:edge": "esbuild src/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=../../supabase/functions/_shared/core.js"
  },
  "devDependencies": {
    "fast-check": "^4.1.1",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4",
    "esbuild": "^0.25.0"
  }
}
