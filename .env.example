# ─────────────────────────────────────────────────────────────────────────────
# Baaki environment. Copy to `.env` and fill in. NEVER commit a real .env.
# ADR-013 / TDR §11: service and LLM keys live ONLY in edge-function env,
# never in the mobile bundle. Anything the app may read must be EXPO_PUBLIC_*.
# ─────────────────────────────────────────────────────────────────────────────

# Prisma (TDR §2.0) — pooled for runtime queries, direct for migrations.
# Local dev via `pnpm db:pg:up` (both point at the same throwaway container):
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/baaki?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:54329/baaki?schema=public"
# Supabase production shape:
# DATABASE_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Mobile app (safe to ship — anon key is RLS-scoped by design)
EXPO_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
EXPO_PUBLIC_SUPABASE_ANON_KEY=""

# Edge functions only — never referenced from apps/*
SUPABASE_SERVICE_ROLE_KEY=""
ANTHROPIC_API_KEY=""
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
