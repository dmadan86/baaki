{
  "name": "baaki",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "test:core": "pnpm --filter @waves/core run test",
    "test:db": "pnpm --filter @waves/db run test",
    "test:db:scenario": "pnpm --filter @waves/db run test:scenario",
    "test:app": "pnpm --filter @waves/mobile run test",
    "test:api": "pnpm --filter @waves/api-client run test",
    "test:web": "pnpm --filter @waves/web run test",
    "test:edge": "vitest run --config supabase/functions/vitest.config.ts",
    "web": "pnpm --filter @waves/web run dev",
    "website": "pnpm --filter @waves/website run dev",
    "admin": "pnpm --filter @waves/admin run dev",
    "db:generate": "pnpm --filter @waves/db run generate",
    "db:migrate": "pnpm --filter @waves/db run migrate:deploy",
    "db:migrate:dev": "pnpm --filter @waves/db run migrate:dev",
    "db:drift": "pnpm --filter @waves/db run drift",
    "db:pg:up": "docker run -d --name baaki-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=baaki -p 54330:5432 postgres:17-alpine",
    "db:pg:down": "docker rm -f baaki-pg",
    "mobile": "pnpm --filter @waves/mobile run start",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "edge:build": "pnpm --filter @waves/core run build:edge",
    "edge:serve": "pnpm edge:build && supabase functions serve --env-file supabase/functions/.env",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "edge:deploy": "pnpm edge:build && supabase functions deploy expense-write sync invite-mint invite-accept export-data receipt-parse fx-rate notify-fanout email-events email-unsubscribe account-delete campaign-broadcast r2-sign storage-sweep storage-recount",
    "coverage": "pnpm -r --if-present run coverage",
    "coverage:core": "pnpm --filter @waves/core run coverage",
    "coverage:db": "pnpm --filter @waves/db run coverage",
    "coverage:app": "pnpm --filter @waves/mobile run coverage",
    "coverage:api": "pnpm --filter @waves/api-client run coverage",
    "coverage:web": "pnpm --filter @waves/web run coverage",
    "coverage:admin": "pnpm --filter @waves/admin run coverage",
    "coverage:watches": "pnpm --filter @waves/mobile run coverage:watches"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "prettier": "^3.4.2",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  }
}
